#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")"
# Use rustup explicitly: some machines put a standalone Cargo ahead of its shims.
thrum_rustc="$(rustup which --toolchain 1.99.1 rustc)"
export PATH="$(dirname -- "$thrum_rustc"):$PATH"
# Keep machine-wide Cargo wrappers opt-in for this reproducible launcher.
# An explicitly supplied RUSTC_WRAPPER still takes precedence.
export RUSTC_WRAPPER="${RUSTC_WRAPPER-}"
# A creator's new scene package is not in the committed lockfile yet, and the xtask runner below
# needs a current lockfile. Resolve the scene from Cargo's metadata first, then add it offline
# (no registry changes) only if it resolves.
case "${1:-}" in
  scene) scene_folder="${2:-}" ;;
  starter) scene_folder=examples/starter ;;
  *) scene_folder= ;;
esac
if [ -n "$scene_folder" ]; then
  "${THRUM_PYTHON:-python3}" scripts/scene_package.py --lock "$scene_folder" >/dev/null || exit 1
fi
exec rustup run 1.99.1 cargo run --locked --offline --quiet --package xtask -- "$@"
