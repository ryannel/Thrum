+++ b/tests/profile.test.mjs
@@ -0,0 +1,10 @@
+import assert from 'node:assert/strict';
+import { sourceProfile } from '../src/profile.js';
+const all={thermals:true,materialCore:true,connectedFeed:true,frontMorph:true};
+assert.equal(sourceProfile(all,1),4);
+assert.equal(sourceProfile({...all,connectedFeed:false},1),2,'Inactive feed cannot narrow legacy core diagnostics');
+assert.equal(sourceProfile({...all,frontMorph:false},1),3);
+assert.equal(sourceProfile({...all,materialCore:false},1),1);
+assert.equal(sourceProfile({...all,thermals:false},1),0);
+for(const family of [0,2,3,4])assert.equal(sourceProfile(all,family),2,'Cb front preparation cannot leak to another family');
+console.log('CPU/GPU source-profile prerequisites and legacy comparison cases passed');
