+    var value = sun_factor;
+    switch view_aux.flags.y {
+        case 1u: { value = sun_visibility(input, ShadowReceiver(input.world_position, vec3(0.0), vec3(0.0), normalize(input.normal))); }
+        case 2u: { value = horizon_visibility(ShadowReceiver(input.world_position, vec3(0.0), vec3(0.0), normalize(input.normal))); }
+        case 3u: { value = cascade_visibility(1u, ShadowReceiver(input.world_position, dpdx(input.world_position), dpdy(input.world_position), normalize(input.normal))); }
+        case 4u: { value = input.world_position.x; }
+        case 5u: { value = input.normal.x; }
+        case 6u: { value = light.ambient_irradiance.x; }
+        case 7u: { value = shade_original(input, sun_factor, front_facing).r; }
+        case 8u: { value = textureSample(base_textures, material_sampler, input.uv, i32(materials[input.material].texture_layers.x)).r; }
+        default: {}
+    }
+    let bits = bitcast<u32>(value);
+    return vec4(f32(bits & 255u), f32((bits >> 8u) & 255u), f32((bits >> 16u) & 255u), f32(bits >> 24u));
+}
